# Copy this file to .env and add your actual API keys
QUOTER_API_KEY=your_quoter_api_key_here
PIPEDRIVE_API_TOKEN=your_pipedrive_api_token_here
QUOTER_CLIENT_SECRET=your_quoter_client_secret_here

# Slack Incoming Webhooks (one URL per channel — a webhook posts only to the channel it was created for)
SLACK_WEBHOOK_URL=your_ok_webhook_here          # success  -> #d-quoter-render-ok
SLACK_ALERT_WEBHOOK_URL=your_alert_webhook_here # failures -> #d-quoter-render-alerts
