# Copy to .env for LOCAL testing only. On Render, set these as environment
# variables / secrets in the dashboard instead (never commit real values).

# Your Pipedrive API token (same one the webhook service already uses).
PIPEDRIVE_API_TOKEN=your_pipedrive_api_token_here

# Long random string that becomes part of the connector URL:
#   https://<service>.onrender.com/<MCP_PATH_SECRET>/mcp
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
MCP_PATH_SECRET=replace_with_a_long_random_string

# Optional: override the Pipedrive API base (defaults to v1).
# PIPEDRIVE_BASE_URL=https://api.pipedrive.com/v1

# Local only. Render provides PORT automatically.
PORT=8000
