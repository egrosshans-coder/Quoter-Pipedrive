name: Quoter-Pipedrive Sync

on:
  schedule:
    # Run once daily at 2 PM UTC (6 AM Pacific, weekdays + Saturday)
    - cron: '0 14 * * 1-6'  # Monday-Saturday, 2 PM UTC (6 AM Pacific)
  workflow_dispatch:  # Allow manual trigger

jobs:
  sync:
    runs-on: ubuntu-latest
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      
    - name: Set up Python
      uses: actions/setup-python@v4
      with:
        python-version: '3.9'
        
    - name: Install dependencies
      run: |
        python -m pip install --upgrade pip
        pip install -r requirements.txt
        
    - name: Run sync
      env:
        QUOTER_API_KEY: ${{ secrets.QUOTER_API_KEY }}
        PIPEDRIVE_API_TOKEN: ${{ secrets.PIPEDRIVE_API_TOKEN }}
        QUOTER_CLIENT_SECRET: ${{ secrets.QUOTER_CLIENT_SECRET }}
      run: |
        python sync_with_date_filter.py
        
