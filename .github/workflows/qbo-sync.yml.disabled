name: Quoter-QBO Sync

on:
  schedule:
    # Run daily at 3 PM UTC (7 AM Pacific, weekdays + Saturday)
    # This runs AFTER the Quoter-Pipedrive sync at 2 PM UTC
    - cron: '0 15 * * 1-6'  # Monday-Saturday, 3 PM UTC (7 AM Pacific)
  workflow_dispatch:  # Allow manual trigger

jobs:
  qbo-sync:
    runs-on: ubuntu-latest
    
    steps:
    - name: Checkout code
      uses: actions/checkout@v4
      
    - name: Set up Python
      uses: actions/setup-python@v4
      with:
        python-version: '3.9'
        
    - name: Install dependencies
      run: |
        python -m pip install --upgrade pip
        pip install -r requirements.txt
        
    - name: Run QBO Sync
      env:
        QUOTER_API_KEY: ${{ secrets.QUOTER_API_KEY }}
        QUOTER_CLIENT_SECRET: ${{ secrets.QUOTER_CLIENT_SECRET }}
        QBO_CLIENT_ID: ${{ secrets.QBO_CLIENT_ID }}
        QBO_CLIENT_SECRET: ${{ secrets.QBO_CLIENT_SECRET }}
        QBO_COMPANY_ID: ${{ secrets.QBO_COMPANY_ID }}
        QBO_ACCESS_TOKEN: ${{ secrets.QBO_ACCESS_TOKEN }}
        QBO_REFRESH_TOKEN: ${{ secrets.QBO_REFRESH_TOKEN }}
        QBO_SANDBOX: ${{ secrets.QBO_SANDBOX }}
        QBO_INCOME_ACCOUNT_ID: ${{ secrets.QBO_INCOME_ACCOUNT_ID }}
        QBO_EXPENSE_ACCOUNT_ID: ${{ secrets.QBO_EXPENSE_ACCOUNT_ID }}
      run: |
        python quoter_to_qbo_sync.py
        
